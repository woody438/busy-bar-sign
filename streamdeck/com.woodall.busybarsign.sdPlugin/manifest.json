{
	"Name": "Busy Bar Sign",
	"Version": "1.2.1.0",
	"Author": "Ian Woodall",
	"Description": "Shows what Busy Bar Sign says on a key, and starts or ends Do Not Disturb when you press it. Mute and Leave keys for your Teams or Zoom meeting.",
	"URL": "https://github.com/woody438/busy-bar-sign",
	"UUID": "com.woodall.busybarsign",
	"Icon": "imgs/plugin/marketplace",
	"Category": "Busy Bar Sign",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "14.4"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "disabled"
	},
	"Actions": [
		{
			"Name": "Status",
			"UUID": "com.woodall.busybarsign.status",
			"Icon": "imgs/actions/status/icon",
			"Tooltip": "What the sign says, live. Press to start or end Do Not Disturb.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/status/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Mute",
			"UUID": "com.woodall.busybarsign.mute",
			"Icon": "imgs/actions/mute/icon",
			"Tooltip": "Mutes or unmutes your Teams or Zoom meeting. Green LIVE, red MUTED.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/mute/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Leave",
			"UUID": "com.woodall.busybarsign.leave",
			"Icon": "imgs/actions/leave/icon",
			"Tooltip": "Leaves your Teams or Zoom meeting. Hold for a second to end a Zoom meeting you host for everyone.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"PropertyInspectorPath": "ui/leave.html",
			"States": [
				{
					"Image": "imgs/actions/leave/key",
					"ShowTitle": false
				}
			]
		}
	]
}